---
import { profile } from '../data/profile';
import { isActive, withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Projects', href: withBase('projects/') },
  { label: 'Research', href: withBase('research/') },
  { label: 'About', href: withBase('about/') },
  { label: 'Resume', href: withBase('resume/') },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href={withBase('')} class="brand" aria-label={`${profile.name}, home`}>
      <span class="logo" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22"
          ><path d="M8 24 L13 15 L21 13 L25 8" stroke="currentColor" stroke-width="2.6" fill="none"
            stroke-linecap="round" stroke-linejoin="round"></path><circle cx="8" cy="24" r="2.2" fill="currentColor"
          ></circle></svg
        >
      </span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo {
    color: var(--accent);
  }
  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover {
    color: var(--text);
    background: var(--bg-hover);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-hover);
  }
  @media (max-width: 560px) {
    .brand-name {
      display: none;
    }
    nav a {
      padding: 6px 9px;
      font-size: 0.875rem;
    }
    .bar {
      gap: 8px;
    }
  }
  @media (max-width: 400px) {
    nav ul {
      gap: 0;
    }
    nav a {
      padding: 6px 7px;
      font-size: 0.8125rem;
    }
  }
</style>
