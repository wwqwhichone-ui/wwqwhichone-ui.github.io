---
import { profile } from '../data/profile';
import { isActive, withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

const nav = [
  { label: 'Projects', labelZh: '项目', href: withBase('projects/') },
  { label: 'Research', labelZh: '研究', href: withBase('research/') },
  { label: 'About', labelZh: '关于', href: withBase('about/') },
  { label: 'Skills', labelZh: '技能', href: withBase('skills/') },
  { label: 'Resume', labelZh: '简历', href: withBase('resume/') },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href={withBase('')} class="brand" aria-label={`${profile.name}, home`}>
      <span class="logo" aria-hidden="true">
        <!-- Modern robotics manipulator geometric icon -->
        <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
          <path
            d="M6 26 L12 16 L20 14 L26 8"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="6" cy="26" r="2.5" fill="currentColor"></circle>
          <circle cx="12" cy="16" r="2" fill="currentColor"></circle>
          <circle cx="20" cy="14" r="2" fill="currentColor"></circle>
          <circle cx="26" cy="8" r="2.5" stroke="currentColor" stroke-width="2" fill="none"></circle>
        </svg>
      </span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Main navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(path, item.href) ? 'page' : undefined}
                data-en={item.label}
                data-zh={item.labelZh}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text);
  }
  .logo {
    color: var(--accent);
    display: flex;
    align-items: center;
  }
  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    font-weight: 500;
  }
  nav a:hover {
    color: var(--text);
    background: var(--bg-hover);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-hover);
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      padding-block: 8px;
      gap: 8px 0;
    }
    .brand {
      gap: 8px;
    }
    .brand-name {
      font-size: 0.95rem;
    }
    .header-actions {
      margin-left: auto;
      gap: 6px;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: visible;
    }
    nav ul {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2px;
      width: 100%;
    }
    nav li {
      flex: 1 1 auto;
      text-align: center;
    }
    nav a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 6px 4px;
      font-size: 0.8125rem;
      min-height: 38px;
      border-radius: var(--radius-sm);
    }
  }
  @media (max-width: 360px) {
    nav a {
      padding: 5px 2px;
      font-size: 0.75rem;
    }
  }
</style>
