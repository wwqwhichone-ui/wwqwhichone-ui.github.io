---
/** Dissertation system pipeline: a responsive list of stages (no image, readable by screen readers). */
const stages = [
  { n: '01', title: 'Voice command', titleZh: '语音指令', text: 'Operator speaks a task', textZh: '操作员口述作业任务' },
  { n: '02', title: 'Speech-to-text', titleZh: '语音识别', text: 'Transcript + confidence', textZh: '文本转录与置信度评估' },
  { n: '03', title: 'Language understanding', titleZh: '语义理解', text: 'Intent and grounded entities', textZh: '意图提取与空间实体接地' },
  { n: '04', title: 'Task planning', titleZh: '任务规划', text: 'LLM proposes a structured plan', textZh: '大模型生成结构化任务计划' },
  { n: '05', title: 'Safety validation', titleZh: '安全验证', text: 'Whitelist, limits, preconditions', textZh: '白名单、参数范围与前置条件校验' },
  { n: '06', title: 'Robot actions', titleZh: '动作执行', text: 'Navigation + manipulation', textZh: '底盘导航与机械臂轨迹协同' },
];
---

<ol class="pipeline" aria-label="System pipeline">
  {
    stages.map((s) => (
      <li>
        <span class="n mono">{s.n}</span>
        <strong data-en={s.title} data-zh={s.titleZh}>{s.title}</strong>
        <span class="t" data-en={s.text} data-zh={s.textZh}>{s.text}</span>
      </li>
    ))
  }
</ol>

<style>
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 18px;
    border-right: 1px solid var(--border);
  }
  li:last-child {
    border-right: 0;
  }
  li:nth-child(5) {
    background: var(--accent-soft);
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -5px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
    background: var(--bg-elev);
    transform: translateY(-50%) rotate(45deg);
    z-index: 1;
  }
  .n {
    color: var(--accent);
    font-size: 0.75rem;
  }
  strong {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .t {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.45;
  }
  @media (max-width: 900px) {
    .pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li {
      border-bottom: 1px solid var(--border);
    }
    li:nth-child(2n) {
      border-right: 0;
    }
    li::after {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .pipeline {
      grid-template-columns: 1fr;
    }
    li {
      border-right: 0;
    }
  }
</style>
