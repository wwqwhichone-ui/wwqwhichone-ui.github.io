---
import type { Project } from '../data/projects';
import { categoryZh } from '../data/projects';
import StatusBadge from './StatusBadge.astro';
import { withBase } from '../lib/url';

interface Props {
  project: Project;
  detailed?: boolean;
}
const { project, detailed = false } = Astro.props;
const external = project.demo?.startsWith('https://') ?? false;
const demoHref = project.demo && (external ? project.demo : withBase(project.demo));
const detailsHref = withBase(`projects/${project.slug}/`);
---

<article class="card project" id={project.slug}>
  <header>
    <div class="meta-row">
      <span class="category-badge" data-en={project.category} data-zh={categoryZh[project.category]}>{project.category}</span>
      <StatusBadge status={project.status} />
    </div>
    <h3>
      <a href={detailsHref} class="title-link">
        <span data-en={project.title} data-zh={project.titleZh}>{project.title}</span>
      </a>
    </h3>
  </header>

  <p class="summary muted">
    <span data-en={project.summary} data-zh={project.summaryZh}>{project.summary}</span>
  </p>

  {
    detailed && (
      <div class="highlights-box">
        <p class="highlights-title mono" data-en="Key Highlights" data-zh="核心技术亮点">Key Highlights</p>
        <ul class="list">
          {project.highlights.map((h, i) => (
            <li>
              <span data-en={h} data-zh={project.highlightsZh[i] || h}>
                {h}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <ul class="tags" aria-label="Tech stack">
    {project.stack.map((s) => <li class="tag">{s}</li>)}
  </ul>

  <footer>
    <a href={detailsHref} class="btn btn-sm btn-outline">
      <span data-en="Deep Dive →" data-zh="技术深度解析 →">Deep Dive →</span>
    </a>

    {
      project.repo ? (
        <a class="btn btn-sm" href={project.repo} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          <span data-en="Code" data-zh="源码">Code</span>
        </a>
      ) : (
        <span class="private mono" data-en="Private Repo" data-zh="私有研究课题">Private Repo</span>
      )
    }

    {
      demoHref && (
        <a class="btn btn-sm btn-primary" href={demoHref} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
          <span data-en="Live Demo" data-zh="在线体验">Live Demo</span>
        </a>
      )
    }
  </footer>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .project:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.12);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .category-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--bg-hover);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .title-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.15s;
  }
  .title-link:hover {
    color: var(--accent);
  }
  .summary {
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .highlights-box {
    background: var(--bg-hover);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 0.875rem;
  }
  .highlights-title {
    font-size: 0.75rem;
    color: var(--text-3);
    margin-bottom: 8px;
  }
  footer {
    margin-top: auto;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 8px;
  }
  .btn-sm {
    padding: 6px 12px;
    font-size: 0.8125rem;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-2);
  }
  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .private {
    font-size: 0.75rem;
    color: var(--text-3);
    padding: 4px 8px;
  }
</style>
