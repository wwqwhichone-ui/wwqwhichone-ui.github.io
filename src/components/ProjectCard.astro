---
import type { Project } from '../data/projects';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: Project;
  detailed?: boolean;
}
const { project, detailed = false } = Astro.props;
---

<article class="card project" id={project.slug}>
  <header>
    <StatusBadge status={project.status} />
    <h3>{project.title}</h3>
  </header>
  <p class="muted">{project.summary}</p>
  {
    detailed && (
      <ul class="list">
        {project.highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  <ul class="tags" aria-label="Tech stack">
    {project.stack.map((s) => <li class="tag">{s}</li>)}
  </ul>
  <footer>
    {
      project.repo ? (
        <a class="btn" href={project.repo} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          Code<span class="sr-only"> for {project.title}</span>
        </a>
      ) : (
        <span class="private mono">Private repository</span>
      )
    }
    {
      project.demo && (
        <a class="btn" href={project.demo} target="_blank" rel="noopener">
          Live demo<span class="sr-only"> of {project.title}</span>
        </a>
      )
    }
  </footer>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.15s ease;
  }
  .project:hover {
    border-color: var(--border-strong);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  footer {
    margin-top: auto;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .private {
    font-size: 0.8rem;
    color: var(--text-3);
  }
</style>
