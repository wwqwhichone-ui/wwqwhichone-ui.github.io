---
import type { ProjectStatus } from '../data/projects';

interface Props {
  status: ProjectStatus;
}
const { status } = Astro.props;
const tone: Record<ProjectStatus, string> = {
  'Proof of concept': 'ok',
  'In progress': 'warn',
  Ongoing: 'info',
  Planned: 'muted',
};
const statusZh: Record<ProjectStatus, string> = {
  'Proof of concept': '概念验证',
  'In progress': '进行中',
  Ongoing: '持续维护',
  Planned: '规划中',
};
---

<span class:list={['badge', tone[status]]} data-en={status} data-zh={statusZh[status]}
  ><span class="dot" aria-hidden="true"></span><span data-en={status} data-zh={statusZh[status]}>{status}</span></span
>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-2);
    padding: 3px 9px 3px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .ok .dot {
    background: var(--ok);
  }
  .warn .dot {
    background: var(--warn);
  }
  .info .dot {
    background: var(--info);
  }
  .muted .dot {
    background: var(--muted);
  }
</style>
