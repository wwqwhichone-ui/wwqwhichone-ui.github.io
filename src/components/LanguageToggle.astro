---
// Language toggle component: switches between English and Chinese instantly
---

<button
  type="button"
  id="lang-toggle"
  class="lang-btn"
  aria-label="Toggle language between English and Chinese"
  title="Switch language (EN / 中文)"
>
  <span class="lang-text" id="lang-current">EN</span>
  <span class="divider">/</span>
  <span class="lang-sub">中</span>
</button>

<script>
  function setupLangToggle() {
    const btn = document.getElementById('lang-toggle');
    const label = document.getElementById('lang-current');
    if (!btn || !label) return;

    function applyLanguage(lang: 'en' | 'zh') {
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
      try {
        localStorage.setItem('lang', lang);
      } catch (_) {}
      label!.textContent = lang === 'zh' ? '中' : 'EN';
      const sub = btn?.querySelector('.lang-sub');
      if (sub) sub.textContent = lang === 'zh' ? 'EN' : '中';

      // Update elements with data-en / data-zh attributes
      document.querySelectorAll<HTMLElement>('[data-en][data-zh]').forEach((el) => {
        const text = lang === 'zh' ? el.getAttribute('data-zh') : el.getAttribute('data-en');
        if (text) {
          if (el.dataset.i18nTarget === 'placeholder' && 'placeholder' in el) {
            (el as HTMLInputElement).placeholder = text;
          } else {
            // Only update direct text nodes if child elements exist, or full text if flat
            if (el.children.length === 0) {
              el.textContent = text;
            }
          }
        }
      });

      // Dispatch custom event for dynamic components (like canvas demo)
      window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
    }

    btn.addEventListener('click', () => {
      const current = document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en';
      const next = current === 'zh' ? 'en' : 'zh';
      applyLanguage(next);
    });

    // Initialize labels on load
    const saved = (document.documentElement.dataset.lang as 'en' | 'zh') || 'en';
    label.textContent = saved === 'zh' ? '中' : 'EN';
    const sub = btn.querySelector('.lang-sub');
    if (sub) sub.textContent = saved === 'zh' ? 'EN' : '中';
  }

  setupLangToggle();
  document.addEventListener('astro:page-load', setupLangToggle);
</script>

<style>
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 550;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }
  .lang-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--bg-hover);
  }
  .lang-text {
    color: var(--accent);
    font-weight: 600;
  }
  .divider {
    opacity: 0.4;
    font-size: 0.75rem;
  }
  .lang-sub {
    opacity: 0.7;
    font-size: 0.75rem;
  }
</style>
