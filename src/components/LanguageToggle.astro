---
// Language toggle component: switches between English and Chinese instantly
---

<button
  type="button"
  id="lang-toggle"
  class="lang-btn"
  aria-label="Toggle language between English and Chinese"
  title="Switch language (EN / 中文)"
>
  <span class="lang-text" id="lang-current">EN</span>
  <span class="divider">/</span>
  <span class="lang-sub">中</span>
</button>

<script>
  import { applyLanguage, resolveLang, type Lang } from '../lib/lang';

  function setupLangToggle() {
    const btn = document.getElementById('lang-toggle');
    const label = document.getElementById('lang-current');
    if (!btn || !label || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';
    const sub = btn.querySelector('.lang-sub');

    function setLanguage(lang: Lang, persist: boolean) {
      applyLanguage(document, lang);
      if (persist) {
        try {
          localStorage.setItem('lang', lang);
        } catch (_) {}
      }
      label!.textContent = lang === 'zh' ? '中' : 'EN';
      if (sub) sub.textContent = lang === 'zh' ? 'EN' : '中';
      // Dynamic components (like the canvas demo) listen for this.
      window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
    }

    btn.addEventListener('click', () => {
      const next = resolveLang(document.documentElement.dataset.lang) === 'zh' ? 'en' : 'zh';
      setLanguage(next, true);
    });

    // Re-apply the saved preference on every page load (the inline head script
    // only sets data-lang; the text itself must be swapped here).
    setLanguage(resolveLang(document.documentElement.dataset.lang), false);
  }

  setupLangToggle();
  document.addEventListener('astro:page-load', setupLangToggle);
</script>

<style>
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 550;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }
  .lang-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--bg-hover);
  }
  .lang-text {
    color: var(--accent);
    font-weight: 600;
  }
  .divider {
    opacity: 0.4;
    font-size: 0.75rem;
  }
  .lang-sub {
    opacity: 0.7;
    font-size: 0.75rem;
  }
</style>
