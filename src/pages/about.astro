---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<Base
  title="About"
  description="Educational background, research interests, and engineering philosophy of Weiqi Wang."
>
  <section class="page-head">
    <div class="container section-head">
      <p class="eyebrow" data-en="Profile & Foundations" data-zh="个人概况与学术底色">Profile & Foundations</p>
      <h1 data-en="Engineering mechanics foundation, robotics & AI focus" data-zh="以工程力学为底色，深耕机器人与智能系统">
        Engineering mechanics foundation, robotics & AI focus
      </h1>
      <p class="lead">
        <span data-en={profile.summary} data-zh={profile.summaryZh}>{profile.summary}</span>
      </p>
    </div>
  </section>

  <!-- Section 1: Education Timeline -->
  <section class="section" aria-labelledby="edu-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-en="Academic Journey" data-zh="高等教育背景">Academic Journey</p>
        <h2 id="edu-h" data-en="Education" data-zh="教育经历">Education</h2>
      </div>

      <ol class="timeline">
        {
          profile.education.map((e) => (
            <li class="card timeline-item">
              <div class="timeline-header">
                <span class="mono deg">{e.degree}</span>
                {e.period && <span class="mono period-badge">{e.period}</span>}
              </div>
              <h3 class="field-title">{e.field}</h3>
              <p class="school-name muted">{e.school}</p>
              {e.notes && (
                <ul class="list notes">
                  {e.notes.map((n, i) => (
                    <li>
                      <span data-en={n} data-zh={e.notesZh ? e.notesZh[i] || n : n}>
                        {n}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Section 2: Engineering Philosophy -->
  <section class="section" aria-labelledby="philo-h">
    <div class="container">
      <div class="philosophy-card card">
        <div class="section-head">
          <p class="eyebrow" data-en="Core Principles" data-zh="工程思想">Core Principles</p>
          <h2 id="philo-h" data-en="Engineering Philosophy" data-zh="工程哲学与研发准则">Engineering Philosophy</h2>
        </div>
        <blockquote class="philo-quote">
          <p class="lead">
            “<span data-en={profile.philosophy} data-zh={profile.philosophyZh}>{profile.philosophy}</span>”
          </p>
        </blockquote>
        <div class="philo-points">
          <div class="philo-point">
            <h4 data-en="1. Deterministic Air-Gaps" data-zh="1. 确定性安全隔离带">1. Deterministic Air-Gaps</h4>
            <p class="muted" data-en="Probabilistic AI models must be separated from motor drivers and joints by formal schemas and spatial collision checks." data-zh="概率性 AI 模型与机器人物理电机之间必须设置由严格模式规范与空间防碰撞构成的硬性隔离。">
              Probabilistic AI models must be separated from motor drivers and joints by formal schemas and spatial collision checks.
            </p>
          </div>
          <div class="philo-point">
            <h4 data-en="2. Verifiable Claims" data-zh="2. 真实可查与可验证">2. Verifiable Claims</h4>
            <p class="muted" data-en="Every published benchmark is reproducible via repository scripts and backed by automated unit tests." data-zh="每一个对外呈现的基准数据均由仓库开源脚本可复现，并由完整的自动化单元测试严格守卫。">
              Every published benchmark is reproducible via repository scripts and backed by automated unit tests.
            </p>
          </div>
          <div class="philo-point">
            <h4 data-en="3. Mechanics Meets Code" data-zh="3. 力学数理与智能软件结合">3. Mechanics Meets Code</h4>
            <p class="muted" data-en="Rigorous continuum and rigid-body mechanics intuition informs numerical stability in Jacobian and IK algorithms." data-zh="扎实的理论力学与刚体物理直觉为雅可比矩阵奇异性处理及逆运动学求解提供数理保障。">
              Rigorous continuum and rigid-body mechanics intuition informs numerical stability in Jacobian and IK algorithms.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Career Aspirations -->
  <section class="section" aria-labelledby="career-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-en="Target Horizons" data-zh="求职意向">Target Horizons</p>
        <h2 id="career-h" data-en="Career Goals & Target Roles" data-zh="目标岗位与专业方向">Career Goals & Target Roles</h2>
        <p
          class="lead"
          data-en="Seeking full-time engineering and research roles at the intersection of robotics, AI agents, and intelligent software engineering."
          data-zh="积极寻求机器人算法、大模型应用开发、具身智能与智能机器人软件工程方向的全职研发机会。"
        >
          Seeking full-time engineering and research roles at the intersection of robotics, AI agents, and intelligent
          software engineering.
        </p>
      </div>

      <div class="roles-grid">
        {
          profile.roles.map((r, i) => (
            <div class="card role-card">
              <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                <span data-en={r} data-zh={profile.rolesZh[i] || r}>{r}</span>
              </h3>
            </div>
          ))
        }
      </div>

      <div class="cta-row">
        <a class="btn btn-primary" href={withBase('projects/')}>
          <span data-en="Explore Projects" data-zh="查阅工程项目">Explore Projects</span>
        </a>
        <a class="btn" href={withBase('resume/')}>
          <span data-en="View Resume" data-zh="浏览个人简历">View Resume</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(56px, 10vw, 96px) 16px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .timeline-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }
  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .deg {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .period-badge {
    font-size: 0.75rem;
    color: var(--text-3);
    background: var(--bg-hover);
    padding: 2px 8px;
    border-radius: 4px;
  }
  .field-title {
    font-size: 1.25rem;
    margin: 0;
  }
  .school-name {
    font-size: 1rem;
    margin: 0;
  }
  .notes {
    margin-top: 8px;
  }
  .philosophy-card {
    padding: 32px;
    border-left: 4px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .philo-quote {
    margin: 0;
    border: none;
    padding: 0;
  }
  .philo-quote p {
    font-style: italic;
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .philo-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .philo-point h4 {
    margin: 0 0 6px 0;
    font-size: 0.9375rem;
    color: var(--accent);
  }
  .philo-point p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .roles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }
  .role-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }
  .role-card .idx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .role-card h3 {
    margin: 0;
    font-size: 1.0625rem;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
