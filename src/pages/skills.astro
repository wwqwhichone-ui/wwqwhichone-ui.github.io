---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<Base
  title="Technical Skills"
  description="Verified technical skills of Weiqi Wang in robotics, artificial intelligence, and software engineering."
>
  <section class="page-head">
    <div class="container section-head">
      <p class="eyebrow" data-en="Capabilities & Tooling" data-zh="技术全景与能力矩阵">Capabilities & Tooling</p>
      <h1 data-en="Skills & Proficiencies" data-zh="专业技能矩阵">Skills & Proficiencies</h1>
      <p
        class="lead"
        data-en="Strictly evidence-based: only tools and concepts verified in code are listed as in active use. No speculative ratings or fake percentages."
        data-zh="严格以可查实证为准：只把在实际项目和代码测试中真实运用与验证的技能列入清单。绝不使用无根据的百分比或虚夸称号。"
      >
        Strictly evidence-based: only tools and concepts verified in code are listed as in active use. No speculative
        ratings or fake percentages.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="skills-grid">
        {
          profile.skillsMatrix.map((cat, idx) => (
            <div class="card skill-card">
              <header class="skill-card-head">
                <span class="mono idx">{String(idx + 1).padStart(2, '0')}</span>
                <h2>
                  <span data-en={cat.title} data-zh={cat.titleZh}>{cat.title}</span>
                </h2>
              </header>

              <div class="skill-items">
                {cat.items.map((item) => (
                  <div class="skill-row">
                    <div class="skill-top">
                      <div class="skill-title-wrap">
                        <span class="skill-name">{item.name}</span>
                        {item.projectSlug && (
                          <a href={withBase(`projects/${item.projectSlug}/`)} class="verified-link mono" title="Verified in project">
                            <span data-en="Verified in Project →" data-zh="实测项目 →">Verified in Project →</span>
                          </a>
                        )}
                      </div>
                      <span class={`status-pill ${item.level === 'using' ? 'active' : 'exploring'}`}>
                        {item.level === 'using' ? (
                          <span data-en="In Active Use" data-zh="项目实测应用">In Active Use</span>
                        ) : (
                          <span data-en="Learning" data-zh="研读探索中">Learning</span>
                        )}
                      </span>
                    </div>
                    {item.note && <p class="skill-note muted">{item.note}</p>}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="verification-box card">
        <div class="v-header">
          <span class="mono v-tag" data-en="HONESTY POLICY" data-zh="技术诚信承诺">HONESTY POLICY</span>
          <h3 data-en="Verification Principles" data-zh="技能核验准则">Verification Principles</h3>
        </div>
        <p class="muted" data-en="Every skill listed under 'In Active Use' can be traced to open-source repository code, mathematical derivations, or automated test suites (e.g. pytest matrices on Python 3.10/3.12). Skills in 'Learning' represent active research areas for coursework and dissertation needs." data-zh="凡标明“项目实测应用”的技术技能，均可直接追溯至 GitHub 开源仓库源码、数理推导或 pytest 自动化测试套件。标注为“研读探索中”的技术代表当前硕士学术课题与进阶实践中的实际进展。">
          Every skill listed under 'In Active Use' can be traced to open-source repository code, mathematical derivations,
          or automated test suites (e.g. pytest matrices on Python 3.10/3.12). Skills in 'Learning' represent active
          research areas for coursework and dissertation needs.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(56px, 10vw, 96px) 16px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .skill-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
  }
  .idx {
    color: var(--accent);
    font-size: 0.8125rem;
  }
  .skill-card-head h2 {
    font-size: 1.125rem;
    margin: 0;
  }
  .skill-items {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .skill-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .skill-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .skill-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .skill-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
  }
  .verified-link {
    font-size: 0.6875rem;
    text-decoration: none;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    padding: 1px 6px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .verified-link:hover {
    background: var(--accent);
    color: #ffffff;
  }
  .status-pill {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .status-pill.active {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .status-pill.exploring {
    background: var(--bg-hover);
    color: var(--text-3);
    border: 1px solid var(--border);
  }
  .skill-note {
    font-size: 0.8125rem;
    margin: 0;
    line-height: 1.4;
  }
  .verification-box {
    border-style: dashed;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: color-mix(in srgb, var(--bg-card) 60%, transparent);
  }
  .v-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .v-tag {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .v-header h3 {
    margin: 0;
    font-size: 1.125rem;
  }
  .verification-box p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  @media (max-width: 480px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
