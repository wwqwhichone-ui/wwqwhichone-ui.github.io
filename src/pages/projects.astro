---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const categories: Array<{ id: string; label: string; labelZh: string }> = [
  { id: 'all', label: 'All', labelZh: '全部' },
  { id: 'Robotics', label: 'Robotics', labelZh: '机器人' },
  { id: 'Artificial Intelligence', label: 'AI', labelZh: '人工智能' },
  { id: 'LLM & AI Agent', label: 'LLM & Agent', labelZh: '大模型与智能体' },
  { id: 'Software Engineering', label: 'Software Eng', labelZh: '软件工程' },
  { id: 'Academic Projects', label: 'Academic', labelZh: '学术课题' },
];

const counts = {
  all: projects.length,
  Robotics: projects.filter((p) => p.category === 'Robotics').length,
  'Artificial Intelligence': projects.filter((p) => p.category === 'Artificial Intelligence').length,
  'LLM & AI Agent': projects.filter((p) => p.category === 'LLM & AI Agent').length,
  'Software Engineering': projects.filter((p) => p.category === 'Software Engineering').length,
  'Academic Projects': projects.filter((p) => p.category === 'Academic Projects').length,
};
---

<Base
  title="Projects"
  description="Real robotics, AI, and software engineering projects by Weiqi Wang with honest verification."
>
  <section class="page-head">
    <div class="container section-head">
      <p class="eyebrow" data-en="Engineering Portfolio" data-zh="工程项目库">Engineering Portfolio</p>
      <h1 data-en="Things I'm building" data-zh="实际构建的项目与工程">Things I'm building</h1>
      <p class="lead" data-en="Each project shows its real status and technical architecture. Interactive demos are linked where available; private dissertation research is accurately marked." data-zh="每个项目均展示真实工程状态与架构方案。在线 Demo 仅在真实可用时开放，私有在研课题如实声明。">
        Each project shows its real status and technical architecture. Interactive demos are linked where available;
        private dissertation research is accurately marked.
      </p>
    </div>
  </section>

  <section class="section filter-section">
    <div class="container">
      <!-- Search & Filter Controls -->
      <div class="controls-card">
        <div class="search-wrap">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="search-icon" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.5" />
            <line x1="13" y1="13" x2="18" y2="18" />
          </svg>
          <input
            type="search"
            id="project-search"
            class="search-input"
            placeholder="Search projects by name, technology, keyword..."
            data-i18n-target="placeholder"
            data-en="Search projects by name, technology, keyword..."
            data-zh="输入项目名、技术栈或关键字搜索..."
            aria-label="Search projects"
          />
        </div>

        <div class="category-tabs" role="tablist" aria-label="Project categories">
          {
            categories.map((cat, i) => (
              <button
                type="button"
                role="tab"
                class={`filter-btn ${i === 0 ? 'active' : ''}`}
                data-category={cat.id}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span data-en={cat.label} data-zh={cat.labelZh}>{cat.label}</span>
                <span class="count-tag">{counts[cat.id as keyof typeof counts] || 0}</span>
              </button>
            ))
          }
        </div>

        <!-- Active Filter / Count Bar -->
        <div class="filter-status-bar">
          <span id="results-count" class="mono results-count" data-total={projects.length}>
            Showing {projects.length} of {projects.length} projects
          </span>
          <button type="button" id="reset-filters" class="reset-btn mono" style="display: none;">
            ✕ Reset Filters
          </button>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-2 projects-grid" id="projects-container">
        {projects.map((p) => (
          <div class="project-item-wrapper" data-category={p.category} data-title={p.title.toLowerCase()} data-stack={p.stack.join(' ').toLowerCase()} data-summary={p.summary.toLowerCase()}>
            <ProjectCard project={p} detailed />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="empty-state card" style="display: none;">
        <p class="mono text-warn" data-en="NO_MATCHING_PROJECTS" data-zh="未找到匹配项目">NO_MATCHING_PROJECTS</p>
        <p class="muted" data-en="No projects match your current filter or search criteria." data-zh="没有找到符合当前搜索关键词或分类条件的项目。">
          No projects match your current filter or search criteria.
        </p>
        <button type="button" id="empty-reset-btn" class="btn btn-sm btn-primary">
          <span data-en="Reset Search & Filters" data-zh="重置搜索与分类">Reset Search & Filters</span>
        </button>
      </div>
    </div>
  </section>
</Base>

<script>
  function setupProjectFilters() {
    const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrapper');
    const emptyState = document.getElementById('empty-state');
    const countDisplay = document.getElementById('results-count');
    const resetBtn = document.getElementById('reset-filters') as HTMLButtonElement | null;
    const emptyResetBtn = document.getElementById('empty-reset-btn');

    const total = items.length;
    let activeCategory = 'all';
    let searchQuery = '';

    function isZh() {
      return document.documentElement.dataset.lang === 'zh';
    }

    function updateCount(visible: number) {
      if (countDisplay) {
        if (isZh()) {
          countDisplay.textContent = `当前展示 ${visible} / ${total} 个项目`;
        } else {
          countDisplay.textContent = `Showing ${visible} of ${total} projects`;
        }
      }

      const isFiltered = activeCategory !== 'all' || searchQuery.length > 0;
      if (resetBtn) {
        resetBtn.style.display = isFiltered ? 'inline-flex' : 'none';
      }
    }

    function filterItems() {
      let visibleCount = 0;
      items.forEach((item) => {
        const itemCat = item.dataset.category || '';
        const title = item.dataset.title || '';
        const stack = item.dataset.stack || '';
        const summary = item.dataset.summary || '';

        const matchesCat = activeCategory === 'all' || itemCat === activeCategory;
        const matchesQuery = !searchQuery || title.includes(searchQuery) || stack.includes(searchQuery) || summary.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
      }

      updateCount(visibleCount);
    }

    function resetAll() {
      activeCategory = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterBtns.forEach((b) => {
        const isAll = b.dataset.category === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-selected', isAll ? 'true' : 'false');
      });
      filterItems();
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        activeCategory = btn.dataset.category || 'all';
        filterItems();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterItems();
      });
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    window.addEventListener('languagechange', () => {
      let count = 0;
      items.forEach((item) => {
        if (item.style.display !== 'none') count++;
      });
      updateCount(count);
    });

    filterItems();
  }

  setupProjectFilters();
  document.addEventListener('astro:page-load', setupProjectFilters);
</script>

<style>
  .page-head {
    padding-block: clamp(56px, 10vw, 96px) 16px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .filter-section {
    padding-top: 0;
  }
  .controls-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.08);
  }
  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--text-3);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    height: 44px;
    padding: 0 16px 0 42px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-btn:hover {
    color: var(--text);
    background: var(--bg-hover);
    border-color: var(--border-strong);
  }
  .filter-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
    font-weight: 600;
  }
  .count-tag {
    font-size: 0.6875rem;
    padding: 1px 6px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 15%, transparent);
  }
  .filter-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .results-count {
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .reset-btn {
    font-size: 0.75rem;
    color: var(--warn);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.15s;
  }
  .reset-btn:hover {
    background: color-mix(in srgb, var(--warn) 15%, transparent);
  }
  .empty-state {
    text-align: center;
    padding: 48px 24px;
    border-style: dashed;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .text-warn {
    color: var(--warn);
  }
</style>
