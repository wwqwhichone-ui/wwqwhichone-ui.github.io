---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Pipeline from '../components/Pipeline.astro';
import { GITHUB_URL, profile, publicContact } from '../data/profile';
import { featuredProjects } from '../data/projects';
import { withBase } from '../lib/url';
---

<Base>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span data-en={profile.headline} data-zh={profile.headlineZh}>{profile.headline}</span>
        </div>

        <h1 class="hero-title">{profile.name}</h1>
        <p class="hero-subtitle mono">
          <span data-en="MSc(Eng) in Robotics & Intelligent Systems @ HKU" data-zh="香港大学 机器人与智能系统 硕士研究生">
            MSc(Eng) in Robotics & Intelligent Systems @ HKU
          </span>
        </p>

        <p class="lead hero-lead">
          <span data-en={profile.tagline} data-zh={profile.taglineZh}>{profile.tagline}</span>
        </p>

        <div class="recruiter-glance card">
          <div class="glance-item">
            <span class="mono glance-tag" data-en="DEGREE" data-zh="学位背景">DEGREE</span>
            <span class="glance-val">HKU MSc + NWPU BEng</span>
          </div>
          <div class="glance-item">
            <span class="mono glance-tag" data-en="TARGET" data-zh="求职方向">TARGET</span>
            <span class="glance-val">Robotics / AI Software</span>
          </div>
          <div class="glance-item">
            <span class="mono glance-tag" data-en="EVIDENCE" data-zh="可验证依据">EVIDENCE</span>
            <span class="glance-val">3 public repos with CI</span>
          </div>
        </div>

        <div class="cta">
          <a class="btn btn-primary" href={withBase('projects/')}>
            <span data-en="View Projects" data-zh="浏览项目">View Projects</span>
          </a>
          <a class="btn" href={withBase('demo/path-planning/')}>
            <span data-en="Interactive Demo" data-zh="在线交互算法演示">Interactive Demo</span>
          </a>
          <a class="btn" href={withBase('research/')}>
            <span data-en="MSc Research" data-zh="学术研究">MSc Research</span>
          </a>
          <a class="btn" href={GITHUB_URL} target="_blank" rel="noopener me">GitHub</a>
        </div>

        <dl class="facts">
          {
            profile.education.map((e) => (
              <div>
                <dt class="mono">{e.degree}</dt>
                <dd>
                  {e.field}
                  <span>{e.school}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Modern Robotics Technical SVG Graphic -->
      <div class="hero-visual" aria-hidden="true">
        <svg viewBox="0 0 400 360" width="100%" height="100%" class="robotics-art" fill="none">
          <!-- Ambient grid -->
          <defs>
            <pattern id="grid-pattern" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M 24 0 L 0 0 0 24" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.15" />
            </pattern>
            <linearGradient id="arm-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.9" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.4" />
            </linearGradient>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-pattern)" />

          <!-- Coordinate Frame Axes -->
          <line x1="60" y1="300" x2="360" y2="300" stroke="currentColor" stroke-width="1.2" opacity="0.3" stroke-dasharray="4 4" />
          <line x1="60" y1="300" x2="60" y2="40" stroke="currentColor" stroke-width="1.2" opacity="0.3" stroke-dasharray="4 4" />
          <text x="350" y="316" font-size="11" font-family="monospace" fill="currentColor" opacity="0.5">X</text>
          <text x="44" y="50" font-size="11" font-family="monospace" fill="currentColor" opacity="0.5">Z</text>

          <!-- Kinematic Arm Chain Representation -->
          <!-- Base Pedestal -->
          <rect x="80" y="280" width="40" height="20" rx="3" fill="var(--bg-hover)" stroke="currentColor" stroke-width="1.8" opacity="0.8" />
          <circle cx="100" cy="280" r="7" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />

          <!-- Link 1 -->
          <line x1="100" y1="280" x2="160" y2="180" stroke="url(#arm-grad)" stroke-width="6" stroke-linecap="round" />
          <circle cx="160" cy="180" r="6" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />

          <!-- Link 2 -->
          <line x1="160" y1="180" x2="260" y2="150" stroke="url(#arm-grad)" stroke-width="5" stroke-linecap="round" />
          <circle cx="260" cy="150" r="5" fill="var(--bg)" stroke="var(--accent)" stroke-width="2.5" />

          <!-- Link 3 & End Effector -->
          <line x1="260" y1="150" x2="310" y2="210" stroke="url(#arm-grad)" stroke-width="4" stroke-linecap="round" />
          <circle cx="310" cy="210" r="4.5" fill="var(--accent)" />

          <!-- End Effector Gripper & Target Reach -->
          <path d="M305 210 L320 200 M305 210 L320 220" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          <circle cx="330" cy="210" r="8" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="3 3" />
          <circle cx="330" cy="210" r="2.5" fill="var(--accent)" />

          <!-- Target Label -->
          <text x="320" y="190" font-size="10" font-family="monospace" fill="var(--accent)" font-weight="600">Goal Pose P(x,y,z)</text>

          <!-- Manipulability Ellipse Overlay -->
          <ellipse cx="310" cy="210" rx="42" ry="22" transform="rotate(-25 310 210)" fill="color-mix(in srgb, var(--accent) 8%, transparent)" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />
          <text x="250" y="245" font-size="9" font-family="monospace" fill="currentColor" opacity="0.6">Yoshikawa w=det(J·Jᵀ)¹/²</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Verified Engineering Stats Banner -->
  <section class="verified-banner-section">
    <div class="container">
      <div class="verified-banner card">
        <div class="v-col">
          <span class="mono v-metric">64</span>
          <span class="v-label" data-en="Pytest cases across 3 robotics repos (run in CI)" data-zh="3 个机器人仓库中的 pytest 用例（CI 运行）">
            Pytest cases across 3 robotics repos (run in CI)
          </span>
        </div>
        <div class="v-col">
          <span class="mono v-metric">32</span>
          <span class="v-label" data-en="Vitest checks for this site" data-zh="本站的 Vitest 测试用例">
            Vitest checks for this site
          </span>
        </div>
        <div class="v-col">
          <span class="mono v-metric">3</span>
          <span class="v-label" data-en="Tested Open-Source Robotics Modules" data-zh="具备完整 CI 矩阵的开源机器人模块">
            Tested Open-Source Robotics Modules
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Core Technical Directions -->
  <section class="section" aria-labelledby="focus-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-en="Research & Capabilities" data-zh="核心技术领域">Research & Capabilities</p>
        <h2 id="focus-h" data-en="Core Technical Directions" data-zh="核心技术方向">Core Technical Directions</h2>
      </div>
      <div class="grid grid-3">
        {
          profile.focus.map((f, i) => (
            <div class="card focus">
              <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                <span data-en={f.title} data-zh={f.titleZh}>{f.title}</span>
              </h3>
              <p class="muted">
                <span data-en={f.text} data-zh={f.textZh}>{f.text}</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section: Featured Projects -->
  <section class="section" aria-labelledby="work-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-en="Selected Work" data-zh="精选项目">Selected Work</p>
        <h2 id="work-h" data-en="Featured Projects" data-zh="代表性工程项目">Featured Projects</h2>
      </div>
      <div class="grid grid-2">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="more">
        <a class="link" href={withBase('projects/')}>
          <span data-en="Explore all projects with deep dives →" data-zh="浏览所有项目并查看深度技术解析 →">
            Explore all projects with deep dives →
          </span>
        </a>
      </p>
    </div>
  </section>

  <!-- Section: MSc Dissertation Spotlight -->
  <section class="section" aria-labelledby="diss-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-en="MSc Dissertation · In Progress" data-zh="硕士课题 · 进行中">MSc Dissertation · In Progress</p>
        <h2 id="diss-h" data-en="From Voice to Verified Robot Action" data-zh="从语音指令到可验证的机器人动作序列">From Voice to Verified Robot Action</h2>
        <p class="muted" data-en="Action generation for a mobile industrial manipulator from spoken natural language commands. Every proposed action sequence passes spatial and kinematic validation before execution." data-zh="针对移动工业机械臂的口语化动作序列生成系统。每一步规划均必须通过多层空间接地与运动学验证后方能驱动硬件。">
          Action generation for a mobile industrial manipulator from spoken natural language commands. Every proposed
          action sequence passes spatial and kinematic validation before execution.
        </p>
      </div>
      <Pipeline />
      <div class="research-link-wrap">
        <a class="btn" href={withBase('research/')}>
          <span data-en="Read Full Dissertation Brief & Architecture →" data-zh="查阅学位论文完整方案与系统架构 →">Read Full Dissertation Brief & Architecture →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section: Contact -->
  <section class="section" aria-labelledby="contact-h">
    <div class="container contact">
      <div class="section-head">
        <p class="eyebrow" data-en="Let's Connect" data-zh="联系方式">Let's Connect</p>
        <h2 id="contact-h" data-en="Open to Robotics & AI Engineering Roles" data-zh="开放求职：机器人与 AI 软件工程研发岗位">
          Open to Robotics & AI Engineering Roles
        </h2>
        <p class="muted">
          <span data-en={profile.roles.join(' · ')} data-zh={profile.rolesZh.join(' · ')}>{profile.roles.join(' · ')}</span>
        </p>
      </div>
      <div class="cta">
        {
          publicContact.map((c) => (
            <a class="btn" href={c.href} target="_blank" rel="noopener me">
              {c.label}
            </a>
          ))
        }
        <a class="btn btn-primary" href={withBase('resume/')}>
          <span data-en="View Resume" data-zh="查看简历">View Resume</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(64px, 12vw, 120px) clamp(48px, 8vw, 80px);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 80% 70% at 30% 30%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 30% 30%, #000 30%, transparent 80%);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    padding: 4px 12px;
    border-radius: 999px;
    width: fit-content;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-2);
    margin: 0;
  }
  .recruiter-glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
    border: 1px solid var(--border);
    margin-top: 4px;
  }
  .glance-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .glance-tag {
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .glance-val {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }
  .text-ok {
    color: var(--ok);
  }
  .hero-lead {
    max-width: 620px;
    line-height: 1.6;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 24px 0 0;
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .facts dt {
    color: var(--text-3);
    font-size: 0.75rem;
    margin-bottom: 4px;
  }
  .facts dd {
    margin: 0;
    font-weight: 550;
  }
  .facts dd span {
    display: block;
    font-weight: 400;
    color: var(--text-2);
    font-size: 0.875rem;
  }
  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-card) 70%, transparent);
    padding: 16px;
    box-shadow: 0 12px 32px -16px rgba(0, 0, 0, 0.2);
  }
  .robotics-art {
    max-width: 380px;
  }
  .verified-banner-section {
    padding-block: 0 32px;
  }
  .verified-banner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding: 20px 28px;
    background: color-mix(in srgb, var(--bg-card) 60%, transparent);
    border: 1px dashed var(--border);
  }
  .v-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .v-metric {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .v-label {
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .focus {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .idx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .more {
    margin-top: 24px;
  }
  .research-link-wrap {
    margin-top: 24px;
  }
  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      max-width: 440px;
      margin: 0 auto;
    }
  }
</style>
