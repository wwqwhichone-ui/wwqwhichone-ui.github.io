---
import Base from '../../layouts/Base.astro';
import { GITHUB_URL } from '../../data/profile';
import { withBase } from '../../lib/url';
---

<Base
  title="Path Planning Demo"
  description="Interactive A*, Dijkstra and RRT path planning in the browser: draw obstacles and compare planners."
>
  <section class="page-head">
    <div class="container section-head">
      <p class="eyebrow" data-en="Interactive Simulation" data-zh="交互式在线仿真">Interactive Simulation</p>
      <h1 data-en="Path planning in the browser" data-zh="浏览器端自主路径规划演示">Path planning in the browser</h1>
      <p class="lead">
        <span data-en="Draw walls, relocate start and goal poses, and compare A*, Dijkstra, and RRT in real time. This is a TypeScript simulation of the algorithms in" data-zh="支持自由绘制障碍墙体、拖拽起点与目标点，实时比对 A*、Dijkstra 与 RRT 规划性能。本页是以下开源库中算法的 TypeScript 实现：">
          Draw walls, relocate start and goal poses, and compare A*, Dijkstra, and RRT in real time. This is a TypeScript simulation of the algorithms in
        </span>{' '}
        <a href={`${GITHUB_URL}/mobile-robot-path-planning`} target="_blank" rel="noopener">mobile-robot-path-planning</a>.
      </p>
    </div>
  </section>

  <section class="section demo-section">
    <div class="container">
      <div class="toolbar" role="toolbar" aria-label="Planner controls">
        <fieldset class="seg">
          <legend class="sr-only">Algorithm</legend>
          <label><input type="radio" name="algo" value="astar" checked /> A*</label>
          <label><input type="radio" name="algo" value="dijkstra" /> Dijkstra</label>
          <label><input type="radio" name="algo" value="rrt" /> RRT</label>
        </fieldset>

        <fieldset class="seg">
          <legend class="sr-only">Drawing tool</legend>
          <label><input type="radio" name="tool" value="wall" checked /> <span data-en="Wall" data-zh="墙体">Wall</span></label>
          <label><input type="radio" name="tool" value="erase" /> <span data-en="Erase" data-zh="擦除">Erase</span></label>
          <label><input type="radio" name="tool" value="start" /> <span data-en="Start" data-zh="起点">Start</span></label>
          <label><input type="radio" name="tool" value="goal" /> <span data-en="Goal" data-zh="终点">Goal</span></label>
        </fieldset>

        <div class="actions">
          <button class="btn btn-primary" id="run" type="button">
            <span data-en="Run" data-zh="运行规划">Run</span>
          </button>
          <button class="btn" id="reset" type="button">
            <span data-en="Reset Map" data-zh="重置预设">Reset Map</span>
          </button>
          <button class="btn" id="clear" type="button">
            <span data-en="Clear Walls" data-zh="清空墙体">Clear Walls</span>
          </button>
        </div>
      </div>

      <div class="stage">
        <canvas
          id="canvas"
          role="img"
          aria-label="Occupancy grid canvas. Click or drag to draw obstacles, then run a planner."></canvas>
      </div>

      <p id="stats" class="stats mono" aria-live="polite">
        <span data-en="Pick an algorithm and press Run." data-zh="选择一种算法并点击“运行规划”。">Pick an algorithm and press Run.</span>
      </p>

      <div class="grid grid-3 notes">
        <div class="card">
          <h3>A*</h3>
          <p class="muted" data-en="Best-first search guided by the octile distance heuristic to the goal. Guaranteed resolution-optimal on the grid." data-zh="基于目标点 Octile 八向距离启发式的最佳优先搜索。在网格离散空间下具备分辨率最优性保证。">
            Best-first search guided by the octile distance heuristic to the goal. Guaranteed resolution-optimal on the grid.
          </p>
        </div>
        <div class="card">
          <h3>Dijkstra</h3>
          <p class="muted" data-en="Uniform-cost search with zero heuristic guidance; expands cells concentrically in every direction." data-zh="无启发式导向的等代价搜索。向所有方向均匀扩散扩展节点，计算开销显著高于 A*。">
            Uniform-cost search with zero heuristic guidance; expands cells concentrically in every direction.
          </p>
        </div>
        <div class="card">
          <h3>RRT</h3>
          <p class="muted" data-en="Rapidly-exploring Random Tree in continuous space; terminates at first collision-free trajectory." data-zh="连续空间快速扩展随机树算法。迅速探寻可行空间并返回首条无碰撞轨迹，速度快但路径非最优。">
            Rapidly-exploring Random Tree in continuous space; terminates at first collision-free trajectory.
          </p>
        </div>
      </div>

      <p class="back">
        <a class="link" href={withBase('projects/')}>
          <span data-en="← Back to all projects" data-zh="← 返回项目列表">← Back to all projects</span>
        </a>
      </p>
    </div>
  </section>
</Base>

<script>
  import { astar, makeGrid, rrt, warehousePreset, type Cell, type Grid } from '../../lib/planner';

  const COLS = 40;
  const ROWS = 24;
  const canvas = document.getElementById('canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const stats = document.getElementById('stats')!;

  let { grid, start, goal } = warehousePreset(COLS, ROWS);
  let overlay: { expanded: Cell[]; shown: number; path: Array<[number, number]> | null; edges: Array<[[number, number], [number, number]]> } = {
    expanded: [],
    shown: 0,
    path: null,
    edges: [],
  };
  let raf = 0;
  let cell = 16;

  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const selected = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;
  const isZh = () => document.documentElement.dataset.lang === 'zh';

  function resize(): void {
    const w = canvas.parentElement!.clientWidth;
    cell = Math.max(6, Math.floor(w / COLS));
    const dpr = window.devicePixelRatio || 1;
    canvas.style.width = `${cell * COLS}px`;
    canvas.style.height = `${cell * ROWS}px`;
    canvas.width = cell * COLS * dpr;
    canvas.height = cell * ROWS * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  function draw(): void {
    const bg = css('--bg-elev');
    const wall = css('--text-2');
    const line = css('--border');
    const accent = css('--accent');
    const visited = css('--accent-soft');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, COLS * cell, ROWS * cell);

    ctx.fillStyle = visited;
    for (let i = 0; i < overlay.shown; i++) {
      const c = overlay.expanded[i]!;
      ctx.fillRect(c.x * cell, c.y * cell, cell, cell);
    }
    ctx.strokeStyle = line;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let x = 0; x <= COLS; x++) {
      ctx.moveTo(x * cell + 0.5, 0);
      ctx.lineTo(x * cell + 0.5, ROWS * cell);
    }
    for (let y = 0; y <= ROWS; y++) {
      ctx.moveTo(0, y * cell + 0.5);
      ctx.lineTo(COLS * cell, y * cell + 0.5);
    }
    ctx.stroke();

    ctx.fillStyle = wall;
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        if (grid.occupied[y * COLS + x]) ctx.fillRect(x * cell, y * cell, cell, cell);
      }
    }

    if (overlay.edges.length > 0) {
      ctx.strokeStyle = accent;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      const edgeCount = Math.min(overlay.shown, overlay.edges.length);
      for (let i = 0; i < edgeCount; i++) {
        const [a, b] = overlay.edges[i]!;
        ctx.moveTo((a[0] + 0.5) * cell, (a[1] + 0.5) * cell);
        ctx.lineTo((b[0] + 0.5) * cell, (b[1] + 0.5) * cell);
      }
      ctx.stroke();
    }

    if (overlay.path && overlay.shown >= (overlay.expanded.length || overlay.edges.length)) {
      ctx.strokeStyle = accent;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      overlay.path.forEach((p, i) => {
        const px = (p[0] + 0.5) * cell;
        const py = (p[1] + 0.5) * cell;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.stroke();
    }

    const dot = (c: Cell, fill: string) => {
      ctx.fillStyle = fill;
      ctx.beginPath();
      ctx.arc((c.x + 0.5) * cell, (c.y + 0.5) * cell, Math.max(3, cell * 0.35), 0, Math.PI * 2);
      ctx.fill();
    };
    dot(start, '#16a34a');
    dot(goal, '#dc2626');
  }

  function clearOverlay(): void {
    cancelAnimationFrame(raf);
    overlay = { expanded: [], shown: 0, path: null, edges: [] };
  }

  function run(): void {
    clearOverlay();
    const algo = selected('algo');
    const t0 = performance.now();
    let summary = '';
    const zh = isZh();

    if (algo === 'rrt') {
      const r = rrt(grid, start, goal, { seed: Math.floor(Math.random() * 1e9) });
      const ms = performance.now() - t0;
      overlay.edges = r.edges;
      overlay.path = r.path;
      summary = r.path
        ? (zh ? `RRT：路径长度 ${r.length.toFixed(1)} 栅格，构建树枝节点 ${r.nodes} 个，耗时 ${ms.toFixed(2)} ms` : `RRT: path ${r.length.toFixed(1)} cells, ${r.nodes} nodes, ${ms.toFixed(2)} ms`)
        : (zh ? `RRT：未找到可行路径（${r.nodes} 个树枝节点）` : `RRT: no path (${r.nodes} nodes)`);
    } else {
      const weight = algo === 'astar' ? 1.0 : 0.0;
      const r = astar(grid, start, goal, weight);
      const ms = performance.now() - t0;
      overlay.expanded = r.expandedOrder;
      overlay.path = r.path ? r.path.map((c) => [c.x, c.y]) : null;
      const name = algo === 'astar' ? 'A*' : 'Dijkstra';
      summary = r.path
        ? (zh ? `${name}：路径长度 ${r.length.toFixed(1)} 栅格，探索 ${r.expandedOrder.length} 个节点，耗时 ${ms.toFixed(2)} ms` : `${name}: path ${r.length.toFixed(1)} cells, ${r.expandedOrder.length} cells expanded, ${ms.toFixed(2)} ms`)
        : (zh ? `${name}：无可行解（已遍历 ${r.expandedOrder.length} 个节点）` : `${name}: no path (${r.expandedOrder.length} cells expanded)`);
    }
    stats.textContent = summary;
    animate();
  }

  function animate(): void {
    const total = Math.max(overlay.expanded.length, overlay.edges.length);
    if (total === 0) return;
    const step = Math.max(1, Math.ceil(total / 30));
    const tick = () => {
      overlay.shown = Math.min(total, overlay.shown + step);
      draw();
      if (overlay.shown < total) raf = requestAnimationFrame(tick);
      else draw();
    };
    raf = requestAnimationFrame(tick);
  }

  function coords(e: MouseEvent): Cell | null {
    const rect = canvas.getBoundingClientRect();
    const x = Math.floor((e.clientX - rect.left) / cell);
    const y = Math.floor((e.clientY - rect.top) / cell);
    if (x < 0 || x >= COLS || y < 0 || y >= ROWS) return null;
    return { x, y };
  }

  let painting = false;
  canvas.addEventListener('mousedown', (e) => {
    painting = true;
    applyTool(e);
  });
  window.addEventListener('mouseup', () => (painting = false));
  canvas.addEventListener('mousemove', (e) => {
    if (painting) applyTool(e);
  });

  function applyTool(e: MouseEvent): void {
    const c = coords(e);
    if (!c) return;
    const tool = selected('tool');
    const idx = c.y * COLS + c.x;
    if (tool === 'wall') {
      if ((c.x === start.x && c.y === start.y) || (c.x === goal.x && c.y === goal.y)) return;
      grid.occupied[idx] = true;
    } else if (tool === 'erase') {
      grid.occupied[idx] = false;
    } else if (tool === 'start') {
      grid.occupied[idx] = false;
      start = c;
    } else if (tool === 'goal') {
      grid.occupied[idx] = false;
      goal = c;
    }
    clearOverlay();
    draw();
  }

  document.getElementById('run')!.addEventListener('click', run);
  document.getElementById('reset')!.addEventListener('click', () => {
    ({ grid, start, goal } = warehousePreset(COLS, ROWS));
    clearOverlay();
    stats.textContent = isZh() ? '地图已重置为仓储预设。' : 'Map reset to warehouse preset.';
    draw();
  });
  document.getElementById('clear')!.addEventListener('click', () => {
    grid = makeGrid(COLS, ROWS) as Grid;
    clearOverlay();
    stats.textContent = isZh() ? '所有障碍墙体已清空。' : 'All walls cleared.';
    draw();
  });

  window.addEventListener('languagechange', () => {
    // Redraw if language changes
    draw();
  });

  new ResizeObserver(resize).observe(canvas.parentElement!);
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .page-head {
    padding-block: clamp(56px, 10vw, 96px) 16px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .demo-section {
    padding-top: 0;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .seg {
    display: inline-flex;
    background: var(--bg-hover);
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--border);
    margin: 0;
  }
  .seg label {
    position: relative;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-2);
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg label:has(input:checked) {
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .stage {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.1);
  }
  canvas {
    display: block;
    margin: 0 auto;
    touch-action: none;
    cursor: crosshair;
  }
  .stats {
    margin-top: 14px;
    color: var(--text-2);
    font-size: 0.875rem;
    min-height: 1.5em;
    padding: 8px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .notes {
    margin-top: 32px;
  }
  .notes .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .notes h3 {
    font-size: 1.125rem;
    margin: 0;
    color: var(--accent);
  }
  .back {
    margin-top: 24px;
  }
</style>
